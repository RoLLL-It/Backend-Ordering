# Roll-IT API — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgres://user:pass@localhost:5432/rollit?sslmode=disable
JWT_SECRET=change-me-to-32-plus-random-bytes-base64
JWT_ACCESS_TTL=15m
REFRESH_TTL=720h
BCRYPT_COST=12
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
S3_ENDPOINT=https://blr1.digitaloceanspaces.com
S3_BUCKET=rollit-menu
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
LOG_LEVEL=info
ENV=development

# Seed
ADMIN_EMAIL=admin@rollit.app
ADMIN_PASSWORD=change-me-strong
