# Roll-IT API — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgres://user:pass@localhost:5432/rollit?sslmode=disable
JWT_SECRET=change-me-to-32-plus-random-bytes-base64
JWT_ACCESS_TTL=15m
REFRESH_TTL=720h
BCRYPT_COST=12
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage — Neon Object Storage (preferred, AWS-standard names) or any
# other S3-compatible provider via the legacy S3_* names below.
# Neon: run `neon link` / `neon deploy` to populate .env.local automatically.
AWS_ENDPOINT_URL_S3=https://your-branch.storage.neon.tech
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-2
S3_BUCKET=roll-it
# Legacy fallback names (DO Spaces, R2, etc.) — used only if the AWS_* vars above are unset:
# S3_ENDPOINT=https://blr1.digitaloceanspaces.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key

LOG_LEVEL=info
ENV=development

# Seed
ADMIN_EMAIL=admin@rollit.app
ADMIN_PASSWORD=change-me-strong
